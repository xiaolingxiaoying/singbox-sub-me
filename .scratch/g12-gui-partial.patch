+/// Why the 「装载覆写」 click installed nothing. Deliberately not `ImportReject`:
+/// whether the document is valid JSON is the engine's judgement (`SetOverride`
+/// parses before it writes), while these are about the file the engine never saw,
+/// and one of them can only be told in the operating system's words.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum LoadReject {
+    /// The page shows no profile, so there is no override file to write. The
+    /// engine's own `require_profile` would refuse it too; saying it here is what
+    /// lets the panel name the missing thing instead of failing after the read.
+    NoProfile,
+    EmptyPath,
+    /// Reading failed. Both halves come from outside the app — the path the user
+    /// typed and the operating system's reason — so the sentence is composed here,
+    /// in whichever language is showing, and nothing about the file is guessed at.
+    Unreadable { path: String, reason: String },
+    /// The file holds nothing. Blank text is the engine's *clear* command, so
+    /// passing an empty file through would delete the override the button was
+    /// pressed to replace; clearing has a button of its own, with a confirmation.
+    BlankFile,
+}
+
+impl LoadReject {
+    pub(crate) fn label(&self, locale: Locale) -> String {
+        match self {
+            Self::NoProfile => tr!(
+                locale,
+                "还没有档案，覆写文件没有能归属的档案。",
+                "There is no profile yet, so an override file has nothing to belong to."
+            )
+            .to_owned(),
+            Self::EmptyPath => tr!(
+                locale,
+                "覆写文件路径不能为空。",
+                "The override file path cannot be empty."
+            )
+            .to_owned(),
+            Self::Unreadable { path, reason } => tr!(
+                locale,
+                format!("读取 {path} 失败：{reason}"),
+                format!("Could not read {path}: {reason}")
+            )
+            .to_owned(),
+            Self::BlankFile => tr!(
+                locale,
+                "这个文件是空的：空内容在引擎那里等于清除覆写，要清除请用「清除覆写」。",
+                "This file is empty: to the engine, blank contents mean clear the override. Use \
+                 Clear override to remove it."
+            )
+            .to_owned(),
+        }
+    }
+}
+
+/// A document read off disk, with the profile it was read for. The view holds one
+/// of these between the two clicks that replace an override that is already in
+/// place, so the second click sends exactly what the first one checked — not a
+/// re-read of a file that may have changed in between.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct PendingLoad {
+    pub(crate) profile: String,
+    /// Only to name the source in the bar's sentence.
+    pub(crate) path: String,
+    pub(crate) contents: String,
+}
+
+impl PendingLoad {
+    /// What the confirming click sends. The caller checks `profile` is still the
+    /// profile on screen first: both clients drive one engine, so an import or a
+    /// delete elsewhere can move the target while the bar is standing, and
+    /// installing onto whoever is current then would be a change nobody asked for.
+    pub(crate) fn command(&self) -> ClientCommand {
+        ClientCommand::SetOverride {
+            profile: self.profile.clone(),
+            contents: self.contents.clone(),
+        }
+    }
+}
+
+/// What 「装载覆写」 makes of the path field, the file behind it, and whether the
+/// profile already has an override to lose.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum LoadAttempt {
+    /// Tell the engine now: there was nothing in the way.
+    Send(ClientCommand),
+    /// Show the bar first: these bytes would replace a file that exists.
+    Confirm(PendingLoad),
+    Refuse(LoadReject),
+}
+
+/// The 「装载覆写」 decision, as a pure function: the file is the user's, written
+/// outside the client (ADR-0023 keeps authoring out of the app), and the target is
+/// always the profile the page is showing — never a name typed into a second box,
+/// because the file on disk is keyed by that profile's sha256 and picking the
+/// wrong one is invisible until a core start that changes nothing.
+///
+/// `read` is the file's contents, or `None` when there was no path to read. The
+/// bytes go to the engine unchanged: what the engine validates is what lands.
+pub(crate) fn override_load_request(
+    profile: Option<&str>,
+    path: &str,
+    read: Option<Result<String, String>>,
+    replaces: bool,
+) -> LoadAttempt {
+    let Some(profile) = profile else {
+        return LoadAttempt::Refuse(LoadReject::NoProfile);
+    };
+    let contents = match read {
+        None => return LoadAttempt::Refuse(LoadReject::EmptyPath),
+        Some(Err(reason)) => {
+            return LoadAttempt::Refuse(LoadReject::Unreadable {
+                path: path.to_owned(),
+                reason,
+            });
+        }
+        Some(Ok(contents)) if contents.trim().is_empty() => {
+            return LoadAttempt::Refuse(LoadReject::BlankFile);
+        }
+        Some(Ok(contents)) => contents,
+    };
+    if replaces {
+        return LoadAttempt::Confirm(PendingLoad {
+            profile: profile.to_owned(),
+            path: path.to_owned(),
+            contents,
+        });
+    }
+    LoadAttempt::Send(ClientCommand::SetOverride {
+        profile: profile.to_owned(),
+        contents,
+    })
+}
+
