+    /// The load's whole promise: bytes the user wrote elsewhere, addressed to the
+    /// profile the page is showing, reaching the engine through `SetOverride` —
+    /// the command that existed and that no client had ever sent.
+    #[test]
+    fn a_read_file_becomes_a_set_override_for_the_profile_the_page_shows() {
+        let document = "{ \"dns\": { \"tag\": \"hand-written\" } }\n";
+        assert_eq!(
+            override_load_request(
+                Some("内网订阅"),
+                "D:/sbctl/override.json",
+                Some(Ok(document.to_owned())),
+                false,
+            ),
+            LoadAttempt::Send(ClientCommand::SetOverride {
+                profile: "内网订阅".to_owned(),
+                contents: document.to_owned(),
+            }),
+            "the bytes go over verbatim, whitespace and trailing newline included"
+        );
+        // With a file already in place the same bytes wait for a second click.
+        assert_eq!(
+            override_load_request(
+                Some("内网订阅"),
+                "D:/sbctl/override.json",
+                Some(Ok(document.to_owned())),
+                true,
+            ),
+            LoadAttempt::Confirm(PendingLoad {
+                profile: "内网订阅".to_owned(),
+                path: "D:/sbctl/override.json".to_owned(),
+                contents: document.to_owned(),
+            }),
+        );
+    }
+
+    /// Nothing is "loaded" onto no one: the request names a profile or refuses,
+    /// rather than letting the engine answer after the file was already read.
+    #[test]
+    fn a_page_without_a_profile_refuses_the_load() {
+        assert_eq!(
+            override_load_request(None, "D:/sbctl/override.json", Some(Ok("{}".to_owned())), true),
+            LoadAttempt::Refuse(LoadReject::NoProfile)
+        );
+    }
+
+    #[test]
+    fn a_blank_path_refuses_without_naming_a_file_the_user_never_typed() {
+        for blank in ["", "   ", "\t"] {
+            assert_eq!(
+                override_load_request(Some("内网订阅"), blank, None, false),
+                LoadAttempt::Refuse(LoadReject::EmptyPath),
+                "no path, nothing to read: {blank:?}"
+            );
+        }
+        assert_ne!(
+            LoadReject::EmptyPath.label(Locale::Zh),
+            LoadReject::NoProfile.label(Locale::Zh),
+            "the two refusals must not blame the same thing"
+        );
+    }
+
+    /// The engine cannot report a file it never received, so this is the one place
+    /// the client speaks for itself — and it says the OS's words, not a guess.
+    #[test]
+    fn an_unreadable_file_is_answered_with_the_os_sentence_and_its_own_path() {
+        let attempt = override_load_request(
+            Some("内网订阅"),
+            "D:/sbctl/missing.json",
+            Some(Err("entity not found".to_owned())),
+            false,
+        );
+        assert_eq!(
+            attempt,
+            LoadAttempt::Refuse(LoadReject::Unreadable {
+                path: "D:/sbctl/missing.json".to_owned(),
+                reason: "entity not found".to_owned(),
+            })
+        );
+        let reject = match attempt {
+            LoadAttempt::Refuse(reject) => reject,
+            other => panic!("a failed read must not send: {other:?}"),
+        };
+        let label = reject.label(Locale::Zh);
+        assert!(label.contains("D:/sbctl/missing.json"), "{label}");
+        assert!(label.contains("entity not found"), "{label}");
+        let english = reject.label(Locale::En);
+        assert!(english.contains("Could not read"), "{english}");
+        assert_ne!(label, english);
+    }
+
+    /// The trap specific to this command: `SetOverride` reads blank text as
+    /// "clear the override", which is `ClearOverride` with a confirmation in front
+    /// of it. Loading an empty file must never be how that happens.
+    #[test]
+    fn an_empty_file_is_refused_because_to_the_engine_empty_means_clear() {
+        for blank in ["", "   ", "\n\t "] {
+            assert_eq!(
+                override_load_request(
+                    Some("内网订阅"),
+                    "D:/sbctl/blank.json",
+                    Some(Ok(blank.to_owned())),
+                    true,
+                ),
+                LoadAttempt::Refuse(LoadReject::BlankFile),
+                "whitespace is not a document: {blank:?}"
+            );
+        }
+        assert!(
+            !LoadReject::BlankFile.label(Locale::En).is_empty(),
+            "an empty file needs a refusal sentence in both languages"
+        );
+        assert!(
+            LoadReject::BlankFile
+                .label(Locale::Zh)
+                .contains("清除覆写"),
+            "the refusal points at the button that does mean clear: {}",
+            LoadReject::BlankFile.label(Locale::Zh)
+        );
+    }
+
+    /// Every refusal the page can show has both halves, because one of them is
+    /// built around an interpolated path and interpolations are where a translation
+    /// gets dropped.
+    #[test]
+    fn every_load_refusal_has_an_english_half() {
+        let rejects = [
+            LoadReject::NoProfile,
+            LoadReject::EmptyPath,
+            LoadReject::Unreadable {
+                path: "C:/x/override.json".to_owned(),
+                reason: "permission denied".to_owned(),
+            },
+            LoadReject::BlankFile,
+        ];
+        for reject in rejects {
+            let zh = reject.label(Locale::Zh);
+            let en = reject.label(Locale::En);
+            assert!(!zh.is_empty() && !en.is_empty(), "{reject:?}");
+            assert_ne!(zh, en, "{reject:?} shares one sentence");
+            assert!(
+                !en.chars().any(|c| ('\u{4e00}'..='\u{9fff}').contains(&c)),
+                "an English refusal leaked Chinese: {en}"
+            );
+        }
+    }
+
+    /// The armed bar sends what was read, for the profile it was read for — not
+    /// for whatever the engine happens to have active when the click lands.
+    #[test]
+    fn a_pending_load_carries_its_own_target() {
+        let pending = PendingLoad {
+            profile: "内网订阅".to_owned(),
+            path: "C:/x/override.json".to_owned(),
+            contents: r#"{"dns":{"tag":"mine"}}"#.to_owned(),
+        };
+        assert_eq!(
+            pending.command(),
+            ClientCommand::SetOverride {
+                profile: "内网订阅".to_owned(),
+                contents: r#"{"dns":{"tag":"mine"}}"#.to_owned(),
+            }
+        );
+    }
 }
