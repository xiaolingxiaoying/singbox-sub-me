/.scratch/acceptance-bin/
# The pinned real cores used to validate each generated version profile:
# ~200 MB of downloaded upstream binaries, reproducible from ci.yml's list.
.scratch/sing-box-cores/

# A sing-box cache_file written with a relative path lands in the process cwd,
# which for a container bind-mounting the repo is the repo root itself.
/cache.db

# Every screenshot run is ephemeral: the logs and the superseded iterations of
# a page stay out, and only the shot that proved a change is force-added.
# sbgui-progressive-workspace is the live issue tracker, not a run directory.
/.scratch/sbgui-*
!/.scratch/sbgui-progressive-workspace/
/.scratch/win11-vm/
# L5 evidence pulled out of the VMware guest (PNGs, manifests, transcripts).
/.scratch/winvm/
